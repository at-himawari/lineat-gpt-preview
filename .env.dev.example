# 開発環境用設定

# LINE Bot設定（開発用）
LINE_CHANNEL_ACCESS_TOKEN=your_dev_line_channel_access_token
LINE_CHANNEL_SECRET=your_dev_line_channel_secret

# Google Gemini API設定
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MAX_TOKENS=8000
GEMINI_TEMPERATURE=1
GEMINI_RESPONSE_CHAR_LIMIT=500

# モデル設定
GEMINI_BASIC_MODEL=gemini-2.5-flash
GEMINI_PREMIUM_MODEL=gemini-3-pro-preview

# MySQL設定（開発用データベース）
DB_HOST=your_dev_mysql_host
DB_USER=lineat_gpt_test_user
DB_PASSWORD=your_test_password_here
DB_NAME=lineat_gpt_test

# デバッグ設定（開発環境では署名検証をスキップ可能）
SKIP_SIGNATURE_VALIDATION=true

# Stripe設定（テストモード）
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_QUOTA_PRICE_ID=price_test_your_quota_price_id
STRIPE_PREMIUM_PRICE_ID=price_test_your_premium_price_id
STRIPE_SUCCESS_URL=https://your-dev-domain.com/success
STRIPE_CANCEL_URL=https://your-dev-domain.com/cancel

# メッセージ制限設定
MESSAGE_LIMIT_3DAYS=300
MESSAGE_QUOTA_EXTENSION=300
