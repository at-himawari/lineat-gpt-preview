# 本番環境用設定
AWS_ROLE_ARN=your_github_sso_arn
# LINE Bot設定（本番用）
LINE_CHANNEL_ACCESS_TOKEN=your_prod_line_channel_access_token
LINE_CHANNEL_SECRET=your_prod_line_channel_secret

# Google Gemini API設定
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MAX_TOKENS=8000
GEMINI_TEMPERATURE=1
GEMINI_RESPONSE_CHAR_LIMIT=500

# モデル設定
GEMINI_BASIC_MODEL=gemini-2.5-flash
GEMINI_PREMIUM_MODEL=gemini-3-pro-preview

# MySQL設定（本番用データベース）
DB_HOST=your_prod_mysql_host
DB_USER=lineat_gpt_prod_user
DB_PASSWORD=your_prod_password_here
DB_NAME=lineat_gpt_prod

# デバッグ設定（本番環境では必ずfalse）
SKIP_SIGNATURE_VALIDATION=false

# Stripe設定（本番モード）
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_QUOTA_PRICE_ID=price_live_your_quota_price_id
STRIPE_PREMIUM_PRICE_ID=price_live_your_premium_price_id
STRIPE_SUCCESS_URL=https://your-domain.com/success
STRIPE_CANCEL_URL=https://your-domain.com/cancel

# メッセージ制限設定
MESSAGE_LIMIT_1DAY=30
MESSAGE_QUOTA_EXTENSION=30
