# LINE Bot設定
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# Google Gemini API設定
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MAX_TOKENS=8000
GEMINI_TEMPERATURE=1
GEMINI_RESPONSE_CHAR_LIMIT=500

# モデル設定
# 基本ユーザー向けのGeminiモデル名
GEMINI_BASIC_MODEL=gemini-2.5-flash

# プレミアムユーザー向けのGeminiモデル名
GEMINI_PREMIUM_MODEL=gemini-3-pro-preview

# MySQL設定
DB_HOST=your_mysql_host
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=your_database_name

# デバッグ設定（テスト時のみ）
SKIP_SIGNATURE_VALIDATION=false

# Stripe設定
# Stripe APIシークレットキー（テストモード: sk_test_、本番モード: sk_live_）
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe公開可能キー（フロントエンド用、現在は未使用）
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Webhookシークレット（署名検証用）
# 初回デプロイ時は空でOK。
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe価格ID - メッセージ枠拡張（300件追加）
# Stripeダッシュボードの Products > Prices から取得
STRIPE_QUOTA_PRICE_ID=price_your_quota_price_id

# Stripe価格ID - プレミアムモデルアップグレード（月額サブスクリプション）
# Stripeダッシュボードの Products > Prices から取得
# 重要: Billing period を "Monthly" に設定すること
STRIPE_PREMIUM_PRICE_ID=price_your_premium_price_id

# 決済成功後のリダイレクトURL
STRIPE_SUCCESS_URL=https://your-domain.com/success

# 決済キャンセル後のリダイレクトURL
STRIPE_CANCEL_URL=https://your-domain.com/cancel

# メッセージ制限設定
# 3日間のメッセージ送信上限（デフォルト: 300件）
MESSAGE_LIMIT_3DAYS=300

# メッセージ枠追加時の追加件数（デフォルト: 300件）
MESSAGE_QUOTA_EXTENSION=300

